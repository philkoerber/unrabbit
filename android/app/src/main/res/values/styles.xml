<resources>
    <style name="Theme.Unrabbit" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">@color/unrabbit_accent</item>
        <item name="android:colorControlActivated">@color/unrabbit_accent</item>
        <item name="android:textColorHighlight">@color/unrabbit_selection_fill</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
